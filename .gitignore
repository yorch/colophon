# Dependencies
node_modules/

# Yarn 4 (node-modules linker) — keep releases, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
.pnp.*
.yarn/install-state.gz

# Build output
dist/
dist-types/
*.tsbuildinfo

# Test output
coverage/

